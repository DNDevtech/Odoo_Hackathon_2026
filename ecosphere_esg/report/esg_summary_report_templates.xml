<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_esg_summary" model="ir.actions.report">
        <field name="name">ESG Summary Report</field>
        <field name="model">esg.department.score</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ecosphere_esg.report_esg_summary</field>
        <field name="report_file">ecosphere_esg.report_esg_summary</field>
        <field name="binding_model_id" ref="model_esg_department_score"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_esg_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>ESG Summary Report</h2>
                        <h3><t t-out="doc.department_id.name"/></h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Environmental</th>
                                    <th>Social</th>
                                    <th>Governance</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><t t-out="doc.period"/></td>
                                    <td><t t-out="doc.environmental_score"/></td>
                                    <td><t t-out="doc.social_score"/></td>
                                    <td><t t-out="doc.governance_score"/></td>
                                    <td><strong><t t-out="doc.total_score"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
