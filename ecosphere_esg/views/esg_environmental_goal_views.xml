<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_environmental_goal_list" model="ir.ui.view">
        <field name="name">esg.environmental.goal.list</field>
        <field name="model">esg.environmental.goal</field>
        <field name="arch" type="xml">
            <list string="Environmental Goals" decoration-success="state == 'achieved'" decoration-muted="state == 'missed'">
                <field name="name"/>
                <field name="department_id"/>
                <field name="target_value"/>
                <field name="current_value"/>
                <field name="progress" widget="progressbar"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_esg_environmental_goal_form" model="ir.ui.view">
        <field name="name">esg.environmental.goal.form</field>
        <field name="model">esg.environmental.goal</field>
        <field name="arch" type="xml">
            <form string="Environmental Goal">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_achieve" type="object" string="Mark Achieved" class="btn-success"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,achieved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Goal Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="department_id"/>
                            <field name="unit"/>
                        </group>
                        <group>
                            <field name="target_value"/>
                            <field name="current_value"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_environmental_goal" model="ir.actions.act_window">
        <field name="name">Environmental Goals</field>
        <field name="res_model">esg.environmental.goal</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
