<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_leaderboard_kanban" model="ir.ui.view">
        <field name="name">esg.leaderboard.kanban</field>
        <field name="model">esg.employee</field>
        <field name="arch" type="xml">
            <kanban default_order="total_xp desc" class="o_kanban_dashboard">
                <field name="name"/>
                <field name="department_id"/>
                <field name="total_xp"/>
                <field name="completed_challenges"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="department_id"/></div>
                            <div><strong>XP:</strong> <field name="total_xp"/></div>
                            <div><strong>Challenges:</strong> <field name="completed_challenges"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_esg_leaderboard" model="ir.actions.act_window">
        <field name="name">Leaderboard</field>
        <field name="res_model">esg.employee</field>
        <field name="view_mode">kanban,list</field>
    </record>
</odoo>
