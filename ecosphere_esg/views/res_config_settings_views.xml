<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.esg</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="EcoSphere ESG Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>EcoSphere ESG Settings</h1>
                    </div>
                    <group string="ESG Configuration">
                        <field name="require_proof"/>
                        <field name="auto_emission_calc"/>
                        <field name="badge_auto_award"/>
                    </group>
                    <group string="ESG Score Weights">
                        <field name="weight_environmental"/>
                        <field name="weight_social"/>
                        <field name="weight_governance"/>
                    </group>
                    <group string="Notification Settings">
                        <field name="notify_compliance_issue"/>
                        <field name="notify_challenge_decision"/>
                        <field name="notify_csr_decision"/>
                        <field name="notify_policy_reminder"/>
                        <field name="notify_badge_unlock"/>
                    </group>
                    <footer>
                        <button name="execute" type="object" string="Save" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_settings" model="ir.actions.act_window">
        <field name="name">ESG Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
