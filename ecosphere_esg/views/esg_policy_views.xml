<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_policy_list" model="ir.ui.view">
        <field name="name">esg.policy.list</field>
        <field name="model">esg.policy</field>
        <field name="arch" type="xml">
            <list string="ESG Policies">
                <field name="name"/>
                <field name="category"/>
                <field name="version"/>
                <field name="effective_date"/>
                <field name="state" widget="badge"
                       decoration-secondary="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_esg_policy_form" model="ir.ui.view">
        <field name="name">esg.policy.form</field>
        <field name="model">esg.policy</field>
        <field name="arch" type="xml">
            <form string="ESG Policy">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" type="object" string="Archive"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Policy Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="version"/>
                            <field name="acknowledgement_required"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="review_date"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Policy details..."/>
                    <notebook>
                        <page string="Acknowledgements">
                            <field name="acknowledgement_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_esg_policy" model="ir.actions.act_window">
        <field name="name">ESG Policies</field>
        <field name="res_model">esg.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
