<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_esg_dashboard_form" model="ir.ui.view">
        <field name="name">esg.dashboard.form</field>
        <field name="model">ecosphere_esg.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <field name="html" widget="html" readonly="1"/>
            </form>
        </field>
    </record>

    <record id="action_esg_dashboard_view" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">ecosphere_esg.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_esg_dashboard_form"/>
        <field name="target">main</field>
        <field name="context">{'create': False, 'delete': False, 'edit': False}</field>
    </record>

    <record id="view_esg_dashboard_kanban" model="ir.ui.view">
        <field name="name">esg.dashboard.kanban</field>
        <field name="model">esg.department.score</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="department_id"/>
                <field name="environmental_score"/>
                <field name="social_score"/>
                <field name="governance_score"/>
                <field name="total_score"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card p-2">
                            <strong><field name="department_id"/></strong>
                            <div class="mt-2">
                                <span class="badge text-bg-success">E: <field name="environmental_score"/></span>
                                <span class="badge text-bg-primary">S: <field name="social_score"/></span>
                                <span class="badge text-bg-warning">G: <field name="governance_score"/></span>
                            </div>
                            <div class="mt-1"><strong>Total:</strong> <field name="total_score"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_esg_dashboard" model="ir.actions.act_window">
        <field name="name">ESG Dashboard</field>
        <field name="res_model">esg.department.score</field>
        <field name="view_mode">kanban,list</field>
    </record>

    <record id="view_esg_carbon_pivot" model="ir.ui.view">
        <field name="name">esg.carbon.pivot</field>
        <field name="model">esg.carbon.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Carbon Emissions Analysis">
                <field name="department_id" type="row"/>
                <field name="source_model" type="column"/>
                <field name="emission_kgco2e" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_esg_carbon_graph" model="ir.ui.view">
        <field name="name">esg.carbon.graph</field>
        <field name="model">esg.carbon.transaction</field>
        <field name="arch" type="xml">
            <graph string="Carbon Emissions" type="bar">
                <field name="department_id"/>
                <field name="emission_kgco2e" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_esg_carbon_analysis" model="ir.actions.act_window">
        <field name="name">Carbon Emissions Analysis</field>
        <field name="res_model">esg.carbon.transaction</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>
</odoo>
