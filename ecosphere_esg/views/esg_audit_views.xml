<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_audit_list" model="ir.ui.view">
        <field name="name">esg.audit.list</field>
        <field name="model">esg.audit</field>
        <field name="arch" type="xml">
            <list string="Audits">
                <field name="name"/>
                <field name="department_id"/>
                <field name="auditor_id"/>
                <field name="audit_date"/>
                <field name="issue_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_esg_audit_form" model="ir.ui.view">
        <field name="name">esg.audit.form</field>
        <field name="model">esg.audit</field>
        <field name="arch" type="xml">
            <form string="Governance Audit">
                <header>
                    <button name="action_start" type="object" string="Start Audit" class="btn-primary"
                            invisible="state != 'planned'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Audit Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="auditor_id"/>
                        </group>
                        <group>
                            <field name="audit_date"/>
                            <field name="issue_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Audit scope and details..."/>
                    <notebook>
                        <page string="Compliance Issues">
                            <field name="compliance_issue_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_esg_audit" model="ir.actions.act_window">
        <field name="name">Audits</field>
        <field name="res_model">esg.audit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
