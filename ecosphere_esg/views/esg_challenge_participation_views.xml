<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_challenge_participation_list" model="ir.ui.view">
        <field name="name">esg.challenge.participation.list</field>
        <field name="model">esg.challenge.participation</field>
        <field name="arch" type="xml">
            <list string="Challenge Participations">
                <field name="name"/>
                <field name="challenge_id"/>
                <field name="employee_id"/>
                <field name="progress" widget="badge"/>
                <field name="approval" widget="badge"
                       decoration-warning="approval == 'pending'"
                       decoration-success="approval == 'approved'"
                       decoration-danger="approval == 'rejected'"/>
                <field name="xp_awarded"/>
            </list>
        </field>
    </record>

    <record id="view_esg_challenge_participation_form" model="ir.ui.view">
        <field name="name">esg.challenge.participation.form</field>
        <field name="model">esg.challenge.participation</field>
        <field name="arch" type="xml">
            <form string="Challenge Participation">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="progress != 'in_progress'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-success"
                            invisible="approval != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="approval != 'pending'"/>
                    <field name="progress" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="challenge_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="xp_awarded"/>
                            <field name="approval" widget="badge"/>
                        </group>
                    </group>
                    <group>
                        <field name="proof" filename="proof_filename"/>
                        <field name="proof_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_challenge_participation" model="ir.actions.act_window">
        <field name="name">Challenge Participations</field>
        <field name="res_model">esg.challenge.participation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
