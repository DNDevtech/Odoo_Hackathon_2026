<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_csr_activity_list" model="ir.ui.view">
        <field name="name">esg.csr.activity.list</field>
        <field name="model">esg.csr.activity</field>
        <field name="arch" type="xml">
            <list string="CSR Activities">
                <field name="name"/>
                <field name="category_id"/>
                <field name="department_id"/>
                <field name="activity_date"/>
                <field name="participation_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_esg_csr_activity_form" model="ir.ui.view">
        <field name="name">esg.csr.activity.form</field>
        <field name="model">esg.csr.activity</field>
        <field name="arch" type="xml">
            <form string="CSR Activity">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-success"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Activity Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="activity_date"/>
                            <field name="participation_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the activity..."/>
                    <notebook>
                        <page string="Participations">
                            <field name="participation_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_esg_csr_activity" model="ir.actions.act_window">
        <field name="name">CSR Activities</field>
        <field name="res_model">esg.csr.activity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
