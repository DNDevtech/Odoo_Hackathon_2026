<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dashboard_content" name="EcoSphere Dashboard Content">
        <style>
            .eco-sidebar {width:230px; min-height:calc(100vh - 46px); background:#0f3d2e; color:#fff; position:fixed; top:46px; left:0; padding:18px 0; z-index:10;}
            .eco-sidebar h6 {color:#9fe7c4; padding:0 20px; font-size:11px; letter-spacing:.08em; text-transform:uppercase;}
            .eco-sidebar a {display:block; color:#d8f5e8; padding:8px 20px; text-decoration:none; font-size:14px;}
            .eco-sidebar a:hover {background:#15543d; color:#fff;}
            .eco-sidebar .sec {margin-top:14px;}
            .eco-main {margin-left:230px; padding:24px 30px;}
            .eco-tile {border-radius:14px; padding:18px 20px; color:#fff; box-shadow:0 2px 8px rgba(0,0,0,.08);}
            .eco-tile .v {font-size:30px; font-weight:700; line-height:1;}
            .eco-tile .l {font-size:12px; opacity:.9; margin-top:6px;}
            .eco-bar {height:22px; background:#0f3d2e; border-radius:5px; color:#fff; font-size:12px; line-height:22px; padding-left:8px; margin-top:4px;}
            .eco-trbar {width:34px; background:#1e9e6a; border-radius:4px 0 0 4px; text-align:center; color:#fff; font-size:11px;}
            .eco-act {border:1px solid #0f3d2e; color:#0f3d2e; border-radius:10px; padding:10px 14px; text-decoration:none; display:inline-block; font-weight:600; font-size:13px;}
            .eco-act:hover {background:#0f3d2e; color:#fff;}
        </style>
        <div class="eco-sidebar">
            <h6>Navigation</h6>
            <a t-att-href="links['carbon']"><i class="fa fa-leaf"/> Environmental</a>
            <a t-att-href="links['csr']"><i class="fa fa-users"/> Social</a>
            <a t-att-href="links['policy']"><i class="fa fa-balance-scale"/> Governance</a>
            <a t-att-href="links['challenge']"><i class="fa fa-trophy"/> Gamification</a>
            <a t-att-href="links['settings']"><i class="fa fa-cog"/> Settings</a>
        </div>
        <div class="eco-main">
            <h2 class="mb-1">EcoSphere: Dashboard</h2>
            <p class="text-muted">Executive ESG Overview</p>
            <div class="row g-3 mb-3">
                <div class="col-md-3"><div class="eco-tile" style="background:#1e9e6a;"><div class="v"><t t-esc="kpi['environmental']"/>/100</div><div class="l">Environmental Score</div></div></div>
                <div class="col-md-3"><div class="eco-tile" style="background:#2f80ed;"><div class="v"><t t-esc="kpi['social']"/>/100</div><div class="l">Social Score</div></div></div>
                <div class="col-md-3"><div class="eco-tile" style="background:#f2994a;"><div class="v"><t t-esc="kpi['governance']"/>/100</div><div class="l">Governance Score</div></div></div>
                <div class="col-md-3"><div class="eco-tile" style="background:#0f3d2e;"><div class="v"><t t-esc="kpi['overall']"/>/100</div><div class="l">Overall ESG Score</div></div></div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col"><div class="card p-3"><div class="h5 mb-0"><t t-esc="total_emission"/></div><div class="small text-muted">Total CO₂e (kg)</div></div></div>
                <div class="col"><div class="card p-3"><div class="h5 mb-0"><t t-esc="active_challenges"/></div><div class="small text-muted">Active Challenges</div></div></div>
                <div class="col"><div class="card p-3"><div class="h5 mb-0"><t t-esc="compliance_open"/></div><div class="small text-muted">Open Compliance Issues</div></div></div>
                <div class="col"><div class="card p-3"><div class="h5 mb-0"><t t-esc="policies"/></div><div class="small text-muted">Policies</div></div></div>
                <div class="col"><div class="card p-3"><div class="h5 mb-0"><t t-esc="audits"/></div><div class="small text-muted">Audits</div></div></div>
            </div>
            <h5 class="mb-2">⚡ Quick Actions</h5>
            <div class="mb-4">
                <a t-att-href="links['carbon']" class="eco-act me-2 mb-2">+ Log Carbon Data</a>
                <a t-att-href="links['challenge']" class="eco-act me-2 mb-2">🏆 Start Challenge</a>
                <a t-att-href="links['reports']" class="eco-act me-2 mb-2">📄 View Reports</a>
                <a t-att-href="links['settings']" class="eco-act me-2 mb-2">⚙ Settings</a>
            </div>
            <div class="row">
                <div class="col-md-7">
                    <div class="card p-3 mb-3">
                        <h6>📈 Emissions Trend (12 mo)</h6>
                        <div class="d-flex align-items-end" style="height:170px; gap:4px;">
                            <t t-foreach="trend" t-as="t">
                                <div class="text-center" style="flex:1;">
                                    <div style="height:140px; display:flex; align-items:flex-end; justify-content:center;">
                                        <div class="eco-trbar" t-att-style="t['style']"><t t-esc="t['value']"/></div>
                                    </div>
                                    <div class="small text-muted mt-1"><t t-esc="t['label']"/></div>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="card p-3">
                        <h6>📊 Department ESG Ranking</h6>
                        <t t-foreach="ranking" t-as="r">
                            <div class="d-flex justify-content-between small"><span><t t-esc="r['name']"/></span><span><t t-esc="r['total']"/>/100</span></div>
                            <div class="eco-bar" t-att-style="r['style']"><t t-esc="r['total']"/></div>
                        </t>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="card p-3">
                        <h6>🕒 Recent Activity</h6>
                        <ul class="list-unstyled mb-0">
                            <t t-foreach="recent_carbon" t-as="c">
                                <li class="border-bottom py-2"><span class="badge text-bg-success">Carbon</span> <t t-esc="c.name"/> — <t t-esc="c.department_id.name if c.department_id else ''"/> <span class="text-muted small"><t t-esc="c.date"/></span></li>
                            </t>
                            <t t-foreach="recent_compliance" t-as="ci">
                                <li class="border-bottom py-2"><span class="badge text-bg-danger">Issue</span> <t t-esc="ci.name"/></li>
                            </t>
                            <t t-foreach="recent_challenges" t-as="ch">
                                <li class="border-bottom py-2"><span class="badge text-bg-warning">Challenge</span> <t t-esc="ch.name"/></li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="dashboard_template" name="EcoSphere Dashboard Page">
        <t t-call="web.layout">
            <t t-set="title">EcoSphere Dashboard</t>
            <t t-call="ecosphere_esg.dashboard_content"/>
        </t>
    </template>
</odoo>
