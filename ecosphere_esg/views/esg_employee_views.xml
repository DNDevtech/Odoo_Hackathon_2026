<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_employee_list" model="ir.ui.view">
        <field name="name">esg.employee.list</field>
        <field name="model">esg.employee</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="name"/>
                <field name="department_id"/>
                <field name="job_title"/>
                <field name="total_xp"/>
                <field name="completed_challenges"/>
                <field name="badge_count"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-muted="status == 'inactive'"/>
            </list>
        </field>
    </record>

    <record id="view_esg_employee_form" model="ir.ui.view">
        <field name="name">esg.employee.form</field>
        <field name="model">esg.employee</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_participations" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="participation_ids" widget="statinfo" string="CSR"/>
                        </button>
                        <button name="action_view_badges" type="object" class="oe_stat_button" icon="fa-trophy">
                            <field name="badge_count" widget="statinfo" string="Badges"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Employee Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="department_id"/>
                            <field name="job_title"/>
                        </group>
                        <group>
                            <field name="total_xp"/>
                            <field name="completed_challenges"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Badges">
                            <field name="badge_ids" readonly="1"/>
                        </page>
                        <page string="Policy Acknowledgements">
                            <field name="policy_acknowledgement_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">esg.employee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
