<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_compliance_issue_list" model="ir.ui.view">
        <field name="name">esg.compliance.issue.list</field>
        <field name="model">esg.compliance.issue</field>
        <field name="arch" type="xml">
            <list string="Compliance Issues" decoration-danger="is_overdue" decoration-warning="severity == 'high'">
                <field name="name"/>
                <field name="audit_id"/>
                <field name="severity" widget="badge"
                       decoration-info="severity == 'low'"
                       decoration-warning="severity == 'medium'"
                       decoration-danger="severity in ('high','critical')"/>
                <field name="owner_id"/>
                <field name="due_date"/>
                <field name="is_overdue" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-secondary="state == 'open'"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state in ('resolved','closed')"/>
            </list>
        </field>
    </record>

    <record id="view_esg_compliance_issue_form" model="ir.ui.view">
        <field name="name">esg.compliance.issue.form</field>
        <field name="model">esg.compliance.issue</field>
        <field name="arch" type="xml">
            <form string="Compliance Issue">
                <header>
                    <button name="action_start" type="object" string="Start Work" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'resolved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,resolved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="OVERDUE" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Issue Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="audit_id"/>
                            <field name="severity"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the compliance issue..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_esg_compliance_issue" model="ir.actions.act_window">
        <field name="name">Compliance Issues</field>
        <field name="res_model">esg.compliance.issue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
