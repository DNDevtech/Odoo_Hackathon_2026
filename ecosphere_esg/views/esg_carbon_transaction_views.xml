<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_carbon_transaction_list" model="ir.ui.view">
        <field name="name">esg.carbon.transaction.list</field>
        <field name="model">esg.carbon.transaction</field>
        <field name="arch" type="xml">
            <list string="Carbon Transactions">
                <field name="name"/>
                <field name="date"/>
                <field name="department_id"/>
                <field name="source_model"/>
                <field name="emission_factor_id"/>
                <field name="quantity"/>
                <field name="emission_kgco2e"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_esg_carbon_transaction_form" model="ir.ui.view">
        <field name="name">esg.carbon.transaction.form</field>
        <field name="model">esg.carbon.transaction</field>
        <field name="arch" type="xml">
            <form string="Carbon Transaction">
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="department_id"/>
                            <field name="source_model"/>
                        </group>
                        <group>
                            <field name="emission_factor_id"/>
                            <field name="quantity"/>
                            <field name="emission_kgco2e"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_esg_carbon_transaction" model="ir.actions.act_window">
        <field name="name">Carbon Transactions</field>
        <field name="res_model">esg.carbon.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
