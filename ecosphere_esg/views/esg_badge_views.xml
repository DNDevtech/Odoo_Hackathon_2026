<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_badge_list" model="ir.ui.view">
        <field name="name">esg.badge.list</field>
        <field name="model">esg.badge</field>
        <field name="arch" type="xml">
            <list string="Badges">
                <field name="name"/>
                <field name="unlock_rule_type"/>
                <field name="unlock_rule_value"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="view_esg_badge_form" model="ir.ui.view">
        <field name="name">esg.badge.form</field>
        <field name="model">esg.badge</field>
        <field name="arch" type="xml">
            <form string="Badge">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="unlock_rule_type"/>
                        <field name="unlock_rule_value"/>
                        <field name="icon"/>
                        <field name="color"/>
                    </group>
                    <field name="employee_ids" readonly="1" string="Earned By"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_badge" model="ir.actions.act_window">
        <field name="name">Badges</field>
        <field name="res_model">esg.badge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
