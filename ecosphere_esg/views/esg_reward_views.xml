<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_reward_list" model="ir.ui.view">
        <field name="name">esg.reward.list</field>
        <field name="model">esg.reward</field>
        <field name="arch" type="xml">
            <list string="Rewards">
                <field name="name"/>
                <field name="points_required"/>
                <field name="stock"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-danger="state == 'out_of_stock'"/>
            </list>
        </field>
    </record>

    <record id="view_esg_reward_form" model="ir.ui.view">
        <field name="name">esg.reward.form</field>
        <field name="model">esg.reward</field>
        <field name="arch" type="xml">
            <form string="Reward">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Reward Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="points_required"/>
                        </group>
                        <group>
                            <field name="stock"/>
                            <field name="state" widget="badge"/>
                            <field name="image"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Redemptions">
                            <field name="redemption_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_reward" model="ir.actions.act_window">
        <field name="name">Rewards</field>
        <field name="res_model">esg.reward</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
