<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esg_challenge_list" model="ir.ui.view">
        <field name="name">esg.challenge.list</field>
        <field name="model">esg.challenge</field>
        <field name="arch" type="xml">
            <list string="Challenges" decoration-info="state == 'active'" decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="category_id"/>
                <field name="xp_reward"/>
                <field name="difficulty"/>
                <field name="deadline"/>
                <field name="participation_count"/>
                <field name="state" widget="badge"
                       decoration-secondary="state == 'draft'"
                       decoration-info="state == 'active'"
                       decoration-warning="state == 'under_review'"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_esg_challenge_form" model="ir.ui.view">
        <field name="name">esg.challenge.form</field>
        <field name="model">esg.challenge</field>
        <field name="arch" type="xml">
            <form string="Challenge">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Send for Review"
                            invisible="state != 'active'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-success"
                            invisible="state != 'under_review'"/>
                    <button name="action_archive" type="object" string="Archive"
                            invisible="state in ('completed','archived')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,under_review,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Challenge Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="difficulty"/>
                            <field name="deadline"/>
                        </group>
                        <group>
                            <field name="xp_reward"/>
                            <field name="evidence_required"/>
                            <field name="participation_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the challenge..."/>
                    <notebook>
                        <page string="Participations">
                            <field name="participation_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_esg_challenge" model="ir.actions.act_window">
        <field name="name">Challenges</field>
        <field name="res_model">esg.challenge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
