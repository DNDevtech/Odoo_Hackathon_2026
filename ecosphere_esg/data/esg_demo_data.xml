<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="esg_department_hr" model="esg.department">
        <field name="name">Human Resources</field>
        <field name="code">HR</field>
    </record>
    <record id="esg_department_operations" model="esg.department">
        <field name="name">Operations</field>
        <field name="code">OPS</field>
    </record>
    <record id="esg_department_finance" model="esg.department">
        <field name="name">Finance</field>
        <field name="code">FIN</field>
    </record>

    <record id="esg_category_csr" model="esg.category">
        <field name="name">Community Service</field>
        <field name="type">csr_activity</field>
    </record>
    <record id="esg_category_tree_planting" model="esg.category">
        <field name="name">Tree Planting</field>
        <field name="type">csr_activity</field>
    </record>
    <record id="esg_category_challenge_green" model="esg.category">
        <field name="name">Green Challenge</field>
        <field name="type">challenge</field>
    </record>

    <record id="esg_emission_electricity" model="esg.emission.factor">
        <field name="name">Grid Electricity</field>
        <field name="category">electricity</field>
        <field name="factor_value">0.82</field>
        <field name="unit">kWh</field>
    </record>
    <record id="esg_emission_diesel" model="esg.emission.factor">
        <field name="name">Diesel</field>
        <field name="category">fuel</field>
        <field name="factor_value">2.68</field>
        <field name="unit">litre</field>
    </record>

    <record id="esg_badge_xp_100" model="esg.badge">
        <field name="name">Eco Starter</field>
        <field name="description">Earned 100 XP for ESG activities</field>
        <field name="unlock_rule_type">xp</field>
        <field name="unlock_rule_value">100</field>
    </record>
    <record id="esg_badge_xp_500" model="esg.badge">
        <field name="name">Eco Champion</field>
        <field name="description">Earned 500 XP for ESG activities</field>
        <field name="unlock_rule_type">xp</field>
        <field name="unlock_rule_value">500</field>
    </record>
    <record id="esg_badge_challenges_5" model="esg.badge">
        <field name="name">Challenge Master</field>
        <field name="description">Completed 5 sustainability challenges</field>
        <field name="unlock_rule_type">challenges_completed</field>
        <field name="unlock_rule_value">5</field>
    </record>

    <record id="esg_reward_1" model="esg.reward">
        <field name="name">Eco T-Shirt</field>
        <field name="description">Branded eco-friendly T-shirt</field>
        <field name="points_required">100</field>
        <field name="stock">20</field>
    </record>
    <record id="esg_reward_2" model="esg.reward">
        <field name="name">Extra Leave Day</field>
        <field name="description">One extra paid leave day</field>
        <field name="points_required">500</field>
        <field name="stock">10</field>
    </record>
</odoo>
