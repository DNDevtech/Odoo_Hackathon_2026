<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_esg_carbon_transaction" model="ir.sequence">
            <field name="name">EcoSphere Carbon Transaction</field>
            <field name="code">esg.carbon.transaction</field>
            <field name="prefix">CT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_esg_employee_participation" model="ir.sequence">
            <field name="name">EcoSphere Employee Participation</field>
            <field name="code">esg.employee.participation</field>
            <field name="prefix">EP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_esg_challenge_participation" model="ir.sequence">
            <field name="name">EcoSphere Challenge Participation</field>
            <field name="code">esg.challenge.participation</field>
            <field name="prefix">CP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_esg_policy_acknowledgement" model="ir.sequence">
            <field name="name">EcoSphere Policy Acknowledgement</field>
            <field name="code">esg.policy.acknowledgement</field>
            <field name="prefix">PA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
