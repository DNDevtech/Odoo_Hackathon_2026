<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_compliance_issue" model="mail.template">
            <field name="name">ESG: New Compliance Issue</field>
            <field name="model_id" ref="model_esg_compliance_issue"/>
            <field name="subject">New Compliance Issue: {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or 'noreply@ecosphere.com') }}</field>
            <field name="email_to">{{ object.owner_id.user_id.email }}</field>
            <field name="body_html" type="html">
                <p>A new compliance issue has been raised:</p>
                <p><strong>Title:</strong> {{ object.name }}</p>
                <p><strong>Severity:</strong> {{ object.severity }}</p>
                <p><strong>Due Date:</strong> {{ object.due_date }}</p>
            </field>
        </record>

        <record id="mail_template_badge_unlock" model="mail.template">
            <field name="name">ESG: Badge Unlocked</field>
            <field name="model_id" ref="model_esg_employee"/>
            <field name="subject">Congratulations! You earned a new badge</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="body_html" type="html">
                <p>Congratulations! You have earned a new badge.</p>
                <p>Keep up the great work on your ESG contributions!</p>
            </field>
        </record>
    </data>
</odoo>
