<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transitops_trip_list" model="ir.ui.view">
        <field name="name">transitops.trip.list</field>
        <field name="model">transitops.trip</field>
        <field name="arch" type="xml">
            <list string="Trips">
                <field name="name"/>
                <field name="source"/>
                <field name="destination"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="cargo_weight"/>
                <field name="planned_distance"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_transitops_trip_form" model="ir.ui.view">
        <field name="name">transitops.trip.form</field>
        <field name="model">transitops.trip</field>
        <field name="arch" type="xml">
            <form string="Trip">
                <header>
                    <button name="action_dispatch" type="object" string="Dispatch" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary"
                            invisible="state != 'dispatched'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft','dispatched')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,dispatched,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Route">
                            <field name="source"/>
                            <field name="destination"/>
                            <field name="cargo_weight"/>
                            <field name="planned_distance"/>
                        </group>
                        <group string="Assignment">
                            <field name="vehicle_id" readonly="state != 'draft'"/>
                            <field name="driver_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group invisible="state not in ('dispatched','completed')">
                        <group string="Completion Details">
                            <field name="actual_distance"/>
                            <field name="fuel_consumed"/>
                            <field name="final_odometer"/>
                        </group>
                        <group string="Timeline">
                            <field name="dispatch_date"/>
                            <field name="complete_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transitops_trip_search" model="ir.ui.view">
        <field name="name">transitops.trip.search</field>
        <field name="model">transitops.trip</field>
        <field name="arch" type="xml">
            <search string="Search Trips">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="source"/>
                <field name="destination"/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Dispatched" name="filter_dispatched" domain="[('state','=','dispatched')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state','=','completed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state','=','cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Driver" name="group_driver" context="{'group_by':'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transitops_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">transitops.trip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transitops_trip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first trip</p>
        </field>
    </record>

</odoo>
