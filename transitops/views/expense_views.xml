<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transitops_expense_list" model="ir.ui.view">
        <field name="name">transitops.expense.list</field>
        <field name="model">transitops.expense</field>
        <field name="arch" type="xml">
            <list string="Expenses" editable="bottom">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="expense_type"/>
                <field name="amount"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_transitops_expense_form" model="ir.ui.view">
        <field name="name">transitops.expense.form</field>
        <field name="model">transitops.expense</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <sheet>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="expense_type"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_transitops_expense_search" model="ir.ui.view">
        <field name="name">transitops.expense.search</field>
        <field name="model">transitops.expense</field>
        <field name="arch" type="xml">
            <search string="Search Expenses">
                <field name="vehicle_id"/>
                <field name="expense_type"/>
                <group expand="0" string="Group By">
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'expense_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transitops_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">transitops.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transitops_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record an expense</p>
        </field>
    </record>

</odoo>
