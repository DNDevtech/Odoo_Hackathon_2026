<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transitops_maintenance_list" model="ir.ui.view">
        <field name="name">transitops.maintenance.list</field>
        <field name="model">transitops.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Records">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="description"/>
                <field name="date"/>
                <field name="cost"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_transitops_maintenance_form" model="ir.ui.view">
        <field name="name">transitops.maintenance.form</field>
        <field name="model">transitops.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Record">
                <header>
                    <button name="action_start" type="object" string="Start Maintenance" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close Maintenance" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id" readonly="state != 'draft'"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="cost"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transitops_maintenance_search" model="ir.ui.view">
        <field name="name">transitops.maintenance.search</field>
        <field name="model">transitops.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance">
                <field name="name"/>
                <field name="vehicle_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Done" name="filter_done" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transitops_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">transitops.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transitops_maintenance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a maintenance record</p>
        </field>
    </record>

</odoo>
