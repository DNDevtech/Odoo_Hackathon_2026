<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transitops_dashboard_form" model="ir.ui.view">
        <field name="name">transitops.dashboard.form</field>
        <field name="model">transitops.dashboard</field>
        <field name="arch" type="xml">
            <form><field name="html" widget="html" readonly="1"/></form>
        </field>
    </record>

    <record id="action_transitops_dashboard_view" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">transitops.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_transitops_dashboard_form"/>
        <field name="target">main</field>
        <field name="context">{'create': False, 'delete': False, 'edit': False}</field>
    </record>

    <!-- Fleet status Kanban dashboard (Assets Available/On Trip/In Shop/Retired as KPI columns) -->
    <record id="view_transitops_dashboard_kanban" model="ir.ui.view">
        <field name="name">transitops.vehicle.dashboard.kanban</field>
        <field name="model">transitops.vehicle</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_dashboard">
                <field name="name"/>
                <field name="model_name"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="model_name"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_transitops_fleet_dashboard" model="ir.actions.act_window">
        <field name="name">Fleet Dashboard</field>
        <field name="res_model">transitops.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vehicles grouped by status: Available, On Trip, In Shop, Retired.
            </p>
        </field>
    </record>

    <!-- Trip analysis: active/pending trips, fleet utilization -->
    <record id="view_transitops_trip_pivot" model="ir.ui.view">
        <field name="name">transitops.trip.pivot</field>
        <field name="model">transitops.trip</field>
        <field name="arch" type="xml">
            <pivot string="Trip Analysis">
                <field name="state" type="row"/>
                <field name="vehicle_id" type="row"/>
                <field name="planned_distance" type="measure"/>
                <field name="actual_distance" type="measure"/>
                <field name="cargo_weight" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_transitops_trip_graph" model="ir.ui.view">
        <field name="name">transitops.trip.graph</field>
        <field name="model">transitops.trip</field>
        <field name="arch" type="xml">
            <graph string="Trip Analysis" type="bar">
                <field name="state"/>
                <field name="planned_distance" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_transitops_trip_analysis" model="ir.actions.act_window">
        <field name="name">Trip Analysis</field>
        <field name="res_model">transitops.trip</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <!-- Vehicle cost / ROI / fuel efficiency analysis -->
    <record id="view_transitops_vehicle_cost_pivot" model="ir.ui.view">
        <field name="name">transitops.vehicle.cost.pivot</field>
        <field name="model">transitops.vehicle</field>
        <field name="arch" type="xml">
            <pivot string="Operational Cost &amp; ROI">
                <field name="vehicle_type" type="row"/>
                <field name="name" type="row"/>
                <field name="total_fuel_cost" type="measure"/>
                <field name="total_maintenance_cost" type="measure"/>
                <field name="total_expense_cost" type="measure"/>
                <field name="total_operational_cost" type="measure"/>
                <field name="fuel_efficiency" type="measure"/>
                <field name="vehicle_roi" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_transitops_vehicle_cost_graph" model="ir.ui.view">
        <field name="name">transitops.vehicle.cost.graph</field>
        <field name="model">transitops.vehicle</field>
        <field name="arch" type="xml">
            <graph string="Operational Cost by Vehicle" type="bar">
                <field name="name"/>
                <field name="total_operational_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_transitops_vehicle_cost_analysis" model="ir.actions.act_window">
        <field name="name">Cost &amp; ROI Analysis</field>
        <field name="res_model">transitops.vehicle</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

</odoo>
