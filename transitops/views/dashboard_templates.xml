<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dashboard_content" name="TransitOps Dashboard Content">
        <style>
            .tr-sidebar {width:230px; min-height:calc(100vh - 46px); background:#0b2545; color:#fff; position:fixed; top:46px; left:0; padding:18px 0; z-index:10;}
            .tr-sidebar h6 {color:#8fb8e0; padding:0 20px; font-size:11px; letter-spacing:.08em; text-transform:uppercase;}
            .tr-sidebar a {display:block; color:#d6e4f5; padding:8px 20px; text-decoration:none; font-size:14px;}
            .tr-sidebar a:hover {background:#133a66; color:#fff;}
            .tr-sidebar .sec {margin-top:14px;}
            .tr-main {margin-left:230px; padding:24px 30px;}
            .tr-tile {border-radius:12px; padding:16px 18px; color:#fff; box-shadow:0 2px 8px rgba(0,0,0,.08);}
            .tr-tile .v {font-size:26px; font-weight:700; line-height:1;}
            .tr-tile .l {font-size:12px; opacity:.92; margin-top:6px;}
            .tr-bar {height:24px; border-radius:5px; color:#fff; font-size:12px; line-height:24px; padding-left:8px; margin-top:4px;}
            .tr-act {border:1px solid #0b2545; color:#0b2545; border-radius:10px; padding:10px 14px; text-decoration:none; display:inline-block; font-weight:600; font-size:13px;}
            .tr-act:hover {background:#0b2545; color:#fff;}
        </style>
        <div class="tr-sidebar">
            <h6>Navigation</h6>
            <a t-att-href="links['vehicle']"><i class="fa fa-truck"/> Fleet</a>
            <a t-att-href="links['driver']"><i class="fa fa-user"/> Drivers</a>
            <a t-att-href="links['trip']"><i class="fa fa-road"/> Trips</a>
            <a t-att-href="links['fuel']"><i class="fa fa-gas-pump"/> Fuel &amp; Expenses</a>
            <a t-att-href="links['maintenance']"><i class="fa fa-wrench"/> Maintenance</a>
        </div>
        <div class="tr-main">
            <h2 class="mb-1">TransitOps: Dashboard</h2>
            <p class="text-muted">Smart Transport Operations Platform</p>
            <div class="row g-3 mb-3">
                <t t-foreach="kpis" t-as="k">
                    <div class="col-md-4 col-lg-2">
                        <div class="tr-tile" t-att-style="'background:%s;' % k[2]"><div class="v"><t t-esc="k[1]"/></div><div class="l"><t t-esc="k[0]"/></div></div>
                    </div>
                </t>
            </div>
            <div class="row g-3 mb-4">
                <div class="col"><div class="card p-3"><div class="h5 mb-0"><t t-esc="utilization"/>%</div><div class="small text-muted">Fleet Utilization</div></div></div>
                <div class="col"><div class="card p-3"><div class="h5 mb-0"><t t-esc="drivers_total"/></div><div class="small text-muted">Total Drivers</div></div></div>
                <div class="col"><div class="card p-3"><div class="h5 mb-0"><t t-esc="max_dist"/></div><div class="small text-muted">Largest Status Group</div></div></div>
            </div>
            <h5 class="mb-2">⚡ Quick Actions</h5>
            <div class="mb-4">
                <a t-att-href="links['vehicle']" class="tr-act me-2 mb-2">+ Add Vehicle</a>
                <a t-att-href="links['trip']" class="tr-act me-2 mb-2">View Trips</a>
                <a t-att-href="links['driver']" class="tr-act me-2 mb-2">View Drivers</a>
                <a t-att-href="links['fuel']" class="tr-act me-2 mb-2">Fuel &amp; Expenses</a>
            </div>
            <div class="row">
                <div class="col-md-7">
                    <div class="card p-3 mb-3">
                        <h6>🚚 Vehicle Status Distribution</h6>
                        <t t-foreach="dist" t-as="d">
                            <div class="d-flex justify-content-between small"><span><t t-esc="d['label']"/></span><span><t t-esc="d['count']"/></span></div>
                            <div class="tr-bar" t-att-style="d['style']"><t t-esc="d['count']"/></div>
                        </t>
                    </div>
                    <div class="card p-3">
                        <h6>📋 Recent Vehicles</h6>
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Reg No.</th><th>Model</th><th>Type</th><th>Status</th></tr></thead>
                            <tbody>
                                <t t-foreach="recent_vehicles" t-as="v">
                                    <tr><td><t t-esc="v.name"/></td><td><t t-esc="v.model_name"/></td><td><t t-esc="v.vehicle_type"/></td><td><t t-esc="v.status"/></td></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="card p-3">
                        <h6>🕒 Recent Trips</h6>
                        <ul class="list-unstyled mb-0">
                            <t t-foreach="recent_trips" t-as="t">
                                <li class="border-bottom py-2"><span class="badge text-bg-info"><t t-esc="t.state"/></span> <t t-esc="t.vehicle_id.model_name if t.vehicle_id else ''"/> — <t t-esc="t.driver_id.name if t.driver_id else ''"/></li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="dashboard_template" name="TransitOps Dashboard Page">
        <t t-call="web.layout">
            <t t-set="title">TransitOps Dashboard</t>
            <t t-call="transitops.dashboard_content"/>
        </t>
    </template>
</odoo>
