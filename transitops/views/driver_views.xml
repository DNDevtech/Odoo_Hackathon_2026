<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transitops_driver_list" model="ir.ui.view">
        <field name="name">transitops.driver.list</field>
        <field name="model">transitops.driver</field>
        <field name="arch" type="xml">
            <list string="Drivers" decoration-danger="is_license_expired" decoration-muted="status == 'suspended'">
                <field name="name"/>
                <field name="license_number"/>
                <field name="license_category"/>
                <field name="license_expiry_date"/>
                <field name="contact_number"/>
                <field name="safety_score"/>
                <field name="is_license_expired" optional="hide"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_transitops_driver_form" model="ir.ui.view">
        <field name="name">transitops.driver.form</field>
        <field name="model">transitops.driver</field>
        <field name="arch" type="xml">
            <form string="Driver">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,on_trip,off_duty,suspended"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Trips"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="License Expired" bg_color="text-bg-danger"
                            invisible="not is_license_expired"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Driver Name"/></h1>
                    </div>
                    <group>
                        <group string="License">
                            <field name="license_number"/>
                            <field name="license_category"/>
                            <field name="license_expiry_date"/>
                            <field name="is_license_expired" invisible="1"/>
                        </group>
                        <group string="Profile">
                            <field name="contact_number"/>
                            <field name="safety_score"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transitops_driver_search" model="ir.ui.view">
        <field name="name">transitops.driver.search</field>
        <field name="model">transitops.driver</field>
        <field name="arch" type="xml">
            <search string="Search Drivers">
                <field name="name"/>
                <field name="license_number"/>
                <filter string="Available" name="filter_available" domain="[('status','=','available')]"/>
                <filter string="Suspended" name="filter_suspended" domain="[('status','=','suspended')]"/>
                <filter string="License Expired" name="filter_expired" domain="[('is_license_expired','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transitops_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">transitops.driver</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transitops_driver_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first driver</p>
        </field>
    </record>

</odoo>
