<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transitops_fuel_log_list" model="ir.ui.view">
        <field name="name">transitops.fuel.log.list</field>
        <field name="model">transitops.fuel.log</field>
        <field name="arch" type="xml">
            <list string="Fuel Logs" editable="bottom">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <field name="liters"/>
                <field name="cost"/>
            </list>
        </field>
    </record>

    <record id="view_transitops_fuel_log_form" model="ir.ui.view">
        <field name="name">transitops.fuel.log.form</field>
        <field name="model">transitops.fuel.log</field>
        <field name="arch" type="xml">
            <form string="Fuel Log">
                <sheet>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="trip_id"/>
                        <field name="date"/>
                        <field name="liters"/>
                        <field name="cost"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_transitops_fuel_log_search" model="ir.ui.view">
        <field name="name">transitops.fuel.log.search</field>
        <field name="model">transitops.fuel.log</field>
        <field name="arch" type="xml">
            <search string="Search Fuel Logs">
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <group expand="0" string="Group By">
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transitops_fuel_log" model="ir.actions.act_window">
        <field name="name">Fuel Logs</field>
        <field name="res_model">transitops.fuel.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transitops_fuel_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a fuel log</p>
        </field>
    </record>

</odoo>
