<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transitops_vehicle_list" model="ir.ui.view">
        <field name="name">transitops.vehicle.list</field>
        <field name="model">transitops.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles" decoration-muted="status == 'retired'"
                  decoration-warning="status == 'in_shop'" decoration-info="status == 'on_trip'">
                <field name="name"/>
                <field name="model_name"/>
                <field name="vehicle_type"/>
                <field name="region"/>
                <field name="max_load_capacity"/>
                <field name="odometer"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-info="status == 'on_trip'"
                       decoration-warning="status == 'in_shop'"
                       decoration-muted="status == 'retired'"/>
            </list>
        </field>
    </record>

    <record id="view_transitops_vehicle_form" model="ir.ui.view">
        <field name="name">transitops.vehicle.form</field>
        <field name="model">transitops.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,on_trip,in_shop,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trips" type="object" class="oe_stat_button" icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Trips"/>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Van-05"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="model_name"/>
                            <field name="vehicle_type"/>
                            <field name="region"/>
                            <field name="active"/>
                        </group>
                        <group string="Capacity &amp; Metrics">
                            <field name="max_load_capacity"/>
                            <field name="odometer"/>
                            <field name="acquisition_cost"/>
                            <field name="total_revenue"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operational Costs &amp; Analytics">
                            <group>
                                <group>
                                    <field name="total_fuel_cost"/>
                                    <field name="total_fuel_liters"/>
                                    <field name="total_maintenance_cost"/>
                                    <field name="total_expense_cost"/>
                                </group>
                                <group>
                                    <field name="total_operational_cost"/>
                                    <field name="total_distance"/>
                                    <field name="fuel_efficiency"/>
                                    <field name="vehicle_roi"/>
                                </group>
                            </group>
                        </page>
                        <page string="Fuel Logs">
                            <field name="fuel_log_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="trip_id"/>
                                    <field name="liters"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Expenses">
                            <field name="expense_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="expense_type"/>
                                    <field name="amount"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transitops_vehicle_search" model="ir.ui.view">
        <field name="name">transitops.vehicle.search</field>
        <field name="model">transitops.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name"/>
                <field name="model_name"/>
                <field name="region"/>
                <filter string="Available" name="filter_available" domain="[('status','=','available')]"/>
                <filter string="On Trip" name="filter_on_trip" domain="[('status','=','on_trip')]"/>
                <filter string="In Shop" name="filter_in_shop" domain="[('status','=','in_shop')]"/>
                <filter string="Retired" name="filter_retired" domain="[('status','=','retired')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'vehicle_type'}"/>
                    <filter string="Region" name="group_region" context="{'group_by':'region'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_transitops_vehicle_kanban" model="ir.ui.view">
        <field name="name">transitops.vehicle.kanban</field>
        <field name="model">transitops.vehicle</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="status"/>
                <field name="model_name"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div><field name="model_name"/></div>
                            <span class="badge rounded-pill text-bg-secondary"><field name="status"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_transitops_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">transitops.vehicle</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_transitops_vehicle_search"/>
        <field name="context">{'search_default_filter_available': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first vehicle</p>
        </field>
    </record>

</odoo>
